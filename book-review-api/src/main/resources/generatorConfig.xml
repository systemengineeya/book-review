<!DOCTYPE generatorConfiguration PUBLIC
        "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
    <context id="PostgreSQL" targetRuntime="MyBatis3">
        <property name="javaFileEncoding" value="UTF-8"/>
        <!-- DB接続 -->
        <jdbcConnection
                driverClass="org.postgresql.Driver"
                connectionURL="jdbc:postgresql://localhost:5432/book_review"
                userId="postgres"
                password="password"/>
        <!-- Java Model -->
        <javaModelGenerator
                targetPackage="jp.systemengineeya.bookreview.api.entity"
                targetProject="src/main/java"/>
        <!-- Mapper XML -->
        <sqlMapGenerator
                targetPackage="mapper/mybatis"
                targetProject="src/main/resources"/>
        <!-- Mapper Interface -->
        <javaClientGenerator
                type="XMLMAPPER"
                targetPackage="jp.systemengineeya.bookreview.api.mapper.mybatis"
                targetProject="src/main/java"/>
        <!-- テーブル指定 -->
        <table tableName="book" domainObjectName="Book">
            <generatedKey column="id" sqlStatement="JDBC" identity="true"/>
        </table>
        <table tableName="review" domainObjectName="Review">
            <generatedKey column="id" sqlStatement="JDBC" identity="true"/>
        </table>
    </context>
</generatorConfiguration>